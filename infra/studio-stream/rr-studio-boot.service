[Unit]
Description=Resume approved Radio Rubben rotation at boot unless operator stopped it
After=local-fs.target rr-studio-stream.service rr-studio-icecast.service
Requires=rr-studio-stream.service rr-studio-icecast.service
[Service]
Type=oneshot
User=rr-studio
Group=rr-studio
UMask=0007
ExecStart=/usr/bin/php /srv/radiorubben-test/studio/scripts/music-boot.php
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/radiorubben-test/studio-data /srv/radiorubben-test/studio-media/music /srv/radiorubben-test/playout
[Install]
WantedBy=multi-user.target
