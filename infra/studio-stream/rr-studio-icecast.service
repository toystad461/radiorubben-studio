# Dedicated unprivileged test output; not the distribution's public service.
[Unit]
Description=Radio Rubben private loopback Icecast test output
After=local-fs.target

[Service]
Type=simple
User=rr-stream
Group=rr-stream
UMask=0077
ExecStart=/usr/bin/icecast2 -c /srv/radiorubben-test/stream-runtime/icecast.xml
Restart=on-failure
RestartSec=3
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/srv/radiorubben-test/stream-runtime/logs
InaccessiblePaths=-/srv/radiorubben-test/studio-data -/srv/radiorubben-test/studio-sessions -/srv/radiorubben-test/studio-media -/srv/radiorubben-test/wordpress -/srv/radiorubben-test/playout -/srv/radiorubben-test/stream-runtime/engine.json -/srv/radiorubben-test/stream-runtime/engine
MemoryMax=128M
TasksMax=32
CPUQuota=50%

[Install]
WantedBy=multi-user.target
