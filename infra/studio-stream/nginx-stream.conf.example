# Include only inside the existing isolated TEST Studio server block after
# reviewing its current PHP-FPM socket. This example has not been installed.
# Replace REVIEW_EXISTING_STUDIO_FPM_SOCKET with that existing Unix socket.
location = /music-test-stream/ {
    limit_except GET { deny all; }
    auth_request /_music_stream_auth;
    proxy_pass http://127.0.0.1:18980/rubben-test.mp3;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 20s;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    add_header Cache-Control "no-store" always;
}

location = /_music_stream_auth {
    internal;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /srv/radiorubben-test/studio/public/music-stream-auth.php;
    fastcgi_param SCRIPT_NAME /music-stream-auth.php;
    fastcgi_param REQUEST_METHOD GET;
    fastcgi_param CONTENT_LENGTH "";
    fastcgi_param HTTP_COOKIE $http_cookie;
    fastcgi_pass_request_body off;
    fastcgi_pass unix:REVIEW_EXISTING_STUDIO_FPM_SOCKET;
}

location = /music-stream-auth.php {
    return 404;
}
