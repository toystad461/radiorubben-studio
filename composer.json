{
  "name": "radiorubben/studio",
  "description": "Radio Rubben Studio for PHP web hosting",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-session": "*",
    "james-heinrich/getid3": "^1.9",
    "jumbojett/openid-connect-php": "^1.0.2"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "scripts": {
    "test": [
      "php tests/news-input.php",
      "php tests/news-input-updates.php",
      "php tests/news-input-page.php get",
      "php tests/news-input-page.php guest",
      "php tests/news-input-page.php observer",
      "php tests/news-input-page.php csrf",
      "php tests/news-input-page.php method",
      "php tests/news-input-page.php save",
      "php tests/news-input-page.php discard",
      "php tests/news-input-page.php discard-invalid",
      "php tests/news-input-page.php demo",
      "php tests/news-input-page.php demo-post",
      "php tests/news-input-page.php update-draft",
      "php tests/news-input-page.php update-keep",
      "php tests/news-input-page.php source-changed",
      "php tests/news-input-page.php conflict",
      "php tests/news-input-page.php forged",
      "php tests/news-input-page.php invalid",
      "php tests/crm.php",
      "php tests/crm-search.php",
      "php tests/crm-website.php",
      "php tests/crm-outreach.php",
      "php tests/crm-outreach-routes.php",
      "php tests/crm-page.php get",
      "php tests/crm-page.php list",
      "php tests/crm-page.php new",
      "php tests/crm-page.php lookup-new",
      "php tests/crm-page.php lookup-existing",
      "php tests/crm-page.php lookup-expired",
      "php tests/crm-page.php select-existing",
      "php tests/crm-page.php select-new",
      "php tests/crm-page.php select-invalid",
      "php tests/crm-page.php guest",
      "php tests/crm-page.php observer",
      "php tests/crm-page.php producer",
      "php tests/crm-page.php presenter",
      "php tests/crm-page.php method",
      "php tests/crm-page.php csrf",
      "php tests/crm-page.php save",
      "php tests/crm-page.php activity",
      "php tests/crm-page.php invalid",
      "php tests/crm-page.php conflict",
      "php tests/crm-page.php forged",
      "php tests/entra-preflight.php",
      "php tests/run.php"
    ],
    "serve": "php -S 127.0.0.1:8080 -t public"
  }
}
